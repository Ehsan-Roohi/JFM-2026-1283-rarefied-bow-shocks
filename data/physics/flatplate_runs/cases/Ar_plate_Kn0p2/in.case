# JFM-2026-1283 curvature test: plate, Ar, Mach 10, Kn=0.2 (VHS lambda 60.9440 mm)
# grid 236x98, cell 10.1695 x 10.2041 mm (lambda/6), dt 300 ns
seed 731270
dimension 2
global gridcut 0.0 comm/sort yes
boundary o ro p
create_box -1.2 1.2 0 1 -.5 .5
create_grid 236 98 1
balance_grid rcb cell
read_surf ../../plate.surf clip 1e-12
global nrho 1.928000e+19 fnum 1.000346e+14
species ../../argon.species Ar
mixture gas Ar nrho 1.928000e+19 vstream 2634.1 0 0 temp 200 trot 200
collide vss gas ../../argon.vss relax constant
collide_modify nearcp yes 10 rotate smooth vibrate no
surf_collide wall diffuse 500.0 1.0
surf_modify all collide wall
fix inflow emit/face gas xlo xhi yhi twopass
timestep 3.000000e-07
create_particles gas n 0 twopass
balance_grid rcb cell
fix lb balance 2000 1.1 rcb part
stats 1000
stats_style step cpu np nattempt ncoll nscoll
restart 20000 checkpoint.A checkpoint.B
run 10000
write_restart checkpoint.warmup
compute f grid all gas n nrho massrho u v w trot
compute t thermal/grid all gas temp press
compute geom property/grid all vol
fix avg ave/grid all 5 200 1000 c_f[*] c_t[*]
compute mfp lambda/grid f_avg[2] f_avg[8] lambda tau knx kny
dump g grid all 1000 fields.*.grid id xc yc xlo xhi ylo yhi c_geom f_avg[*] c_mfp[*]
run 10000
write_restart checkpoint.final
print "CURVATURE_RUN_COMPLETE 20000"
