seed 438719
dimension 2
global gridcut 0.0 comm/sort yes
boundary o ro p
create_box -0.2 0.65 0.0 0.4 -0.5 0.5
create_grid 776 400 1
balance_grid rcb cell
global nrho 3.856e20 fnum 21118556701030.93
species ../Ar.species Ar
mixture gas Ar vstream 2634.1 0.0 0.0 temp 200.0
collide vss gas ../Ar.vss
collide_modify nearcp yes 10
read_surf ../cylinder.surf clip 1e-12
surf_collide wall diffuse 500.0 1.0
surf_modify all collide wall
balance_grid rcb cell
create_particles gas n 0 twopass
fix inflow emit/face gas xlo xhi yhi twopass
timestep 2e-08
stats 20
stats_style step cpu np nattempt ncoll nscoll
compute fields grid all gas n nrho massrho u v w
compute thermal thermal/grid all gas temp press
fix avg ave/grid all 1 100 100 c_fields[*] c_thermal[*]
compute mfp lambda/grid f_avg[2] f_avg[7] lambda tau knx kny
compute geom property/grid all vol
dump gridout grid all 100 fields.*.grid id xc yc xlo xhi ylo yhi c_geom f_avg[*] c_mfp[*]
write_grid grid.dat
restart 100 checkpoint.A checkpoint.B
run 200
write_restart checkpoint.final
print "PILOT_TARGET_COMPLETE 200"
