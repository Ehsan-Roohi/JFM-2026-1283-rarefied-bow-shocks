seed 438836
read_restart ../../N2_M15_vibration/checkpoint.final
collide vss gas ../../vibration.vss relax variable
collide_modify nearcp yes 10 rotate smooth vibrate discrete
surf_collide wall diffuse 500.0 1.0
surf_modify all collide wall
fix inflow emit/face gas xlo xhi yhi twopass
timestep 1e-08
stats 1000
stats_style step cpu np nattempt ncoll nscoll
restart 5000 checkpoint.A checkpoint.B
run 200000 upto
write_restart checkpoint.warmup
compute fields grid all gas n nrho massrho u v w trot erot tvib evib usq vsq wsq
compute thermal thermal/grid all gas temp press
fix avg ave/grid all 20 1000 20000 c_fields[*] c_thermal[*]
compute density grid all species nrho
fix densityavg ave/grid all 20 1000 20000 c_density[*]
compute mfp lambda/grid f_densityavg[*] f_avg[14] lambda tau knx kny
compute geom property/grid all vol
dump gridout grid all 20000 fields.*.grid id xc yc xlo xhi ylo yhi c_geom f_avg[*] f_densityavg[*] c_mfp[*]
run 400000 upto
write_restart checkpoint.final
print "PRODUCTION_COMPLETE 400000"
