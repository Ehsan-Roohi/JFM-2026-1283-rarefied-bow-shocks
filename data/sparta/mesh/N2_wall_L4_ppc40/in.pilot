seed 719381
dimension 2
global gridcut 0.0 comm/sort yes
boundary o ro p
create_box -.2 .65 0 .4 -.5 .5
create_grid 776 400 1
region disk1 cylinder z .1524 0 0.3024 -.5 .5
region front1 block -.2 0.3 0 0.38 -.5 .5
region band1 intersect 2 front1 disk1
adapt_grid all refine random 1.0 0.0 region band1 one cells 2 2 1 maxlevel 2
region disk2 cylinder z .1524 0 0.27239999999999998 -.5 .5
region front2 block -.2 0.26 0 0.35 -.5 .5
region band2 intersect 2 front2 disk2
adapt_grid all refine random 1.0 0.0 region band2 one cells 2 2 1 maxlevel 3
region disk3 cylinder z .1524 0 0.18440000000000001 -.5 .5
region front3 block -.2 0.1 0 0.2 -.5 .5
region band3 intersect 2 front3 disk3
adapt_grid all refine random 1.0 0.0 region band3 one cells 2 2 1 maxlevel 4
region disk4 cylinder z .1524 0 0.16440000000000002 -.5 .5
region front4 block -.2 0.07 0 0.14 -.5 .5
region band4 intersect 2 front4 disk4
adapt_grid all refine random 1.0 0.0 region band4 one cells 2 2 1 maxlevel 5
balance_grid rcb cell
read_surf ../cylinder.surf clip 1e-12
global weight cell volume
global nrho 3.941e+20 fnum 9.8525e+18
species ../baseline.species N2
mixture gas N2 nrho 3.941e+20 vstream 2883.3 0 0 temp 200 trot 200
mixture gas group bulk
collide vss gas ../baseline.vss relax constant
collide_modify nearcp yes 10 rotate smooth vibrate no
surf_collide wall diffuse 500.0 1.0
surf_modify all collide wall
fix inflow emit/face gas xlo xhi yhi twopass
timestep 5e-9
stats 100
stats_style step cpu np nattempt ncoll nscoll
balance_grid rcb cell
create_particles gas n 0 twopass
compute f grid all gas n nrho massrho u v w trot
compute t thermal/grid all gas temp press
compute v property/grid all vol
fix a ave/grid all 1 100 100 c_f[*] c_t[*]
dump g grid all 100 fields.*.grid id xc yc xlo xhi ylo yhi c_v f_a[*]
run 200
write_restart checkpoint.final
print "MESH_PILOT_COMPLETE"
