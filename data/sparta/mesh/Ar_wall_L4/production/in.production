seed 719498
read_restart ../../Ar_wall_L4/checkpoint.final
collide vss gas ../../argon.vss relax constant
collide_modify nearcp yes 10 rotate smooth vibrate no
surf_collide wall diffuse 500.0 1.0
surf_modify all collide wall
fix inflow emit/face gas xlo xhi yhi twopass
timestep 5e-9
stats 100
stats_style step cpu np nattempt ncoll nscoll
stats 1000
restart 5000 checkpoint.A checkpoint.B
run 400000 upto
write_restart checkpoint.warmup
compute f grid all gas n nrho massrho u v w trot
compute t thermal/grid all gas temp press
compute geom property/grid all vol
fix avg ave/grid all 40 1000 40000 c_f[*] c_t[*]
compute mfp lambda/grid f_avg[2] f_avg[8] lambda tau knx kny
dump g grid all 40000 fields.*.grid id xc yc xlo xhi ylo yhi c_geom f_avg[*] c_mfp[*]
run 800000 upto
write_restart checkpoint.final
print "WALL_PRODUCTION_COMPLETE 800000"
