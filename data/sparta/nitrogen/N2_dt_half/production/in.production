seed 718391
read_restart ../../N2_dt_half/checkpoint.final
collide vss gas ../../N2.vss relax constant
collide_modify nearcp yes 10 rotate smooth vibrate no
surf_collide wall diffuse 500.0 1.0
surf_modify all collide wall
fix inflow emit/face gas xlo xhi yhi twopass
timestep 1e-08
stats 1000
stats_style step cpu np nattempt ncoll nscoll
restart 1000 checkpoint.A checkpoint.B
run 200000 upto
write_restart checkpoint.warmup
compute fields grid all gas n nrho massrho u v w trot erot
compute thermal thermal/grid all gas temp press
fix avg ave/grid all 20 1000 20000 c_fields[*] c_thermal[*]
compute mfp lambda/grid f_avg[2] f_avg[9] lambda tau knx kny
compute geom property/grid all vol
dump gridout grid all 20000 fields.*.grid id xc yc xlo xhi ylo yhi c_geom f_avg[*] c_mfp[*]
run 400000 upto
write_restart checkpoint.final
print "PRODUCTION_TARGET_COMPLETE 400000"
