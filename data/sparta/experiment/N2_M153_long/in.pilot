seed 791837
dimension 3
global gridcut 0.0 comm/sort yes
boundary o p p
create_box -0.32 0.32 0 .001 0 .001
create_grid 3200 1 1
balance_grid rcb cell
global nrho 3.941e+20 fnum 394100000
species ../baseline.species N2
mixture gas N2 nrho 3.941e+20 vstream 540.29526985058465 0 0 temp 300.0 trot 300.0
mixture gas group bulk
collide vss gas ../baseline.vss relax constant
collide_modify nearcp yes 10 rotate smooth vibrate no
mixture upstream N2 nrho 3.941e+20 vstream 540.29526985058465 0 0 temp 300.0 trot 300.0
mixture downstream N2 nrho 7.5403453799942783e+20 vstream 282.38808054211034 0 0 temp 402.0864114585558 trot 402.0864114585558
region left block -0.32 0 0 .001 0 .001
region right block 0 0.32 0 .001 0 .001
create_particles upstream n 0 region left twopass
create_particles downstream n 0 region right twopass
fix inlet emit/face upstream xlo twopass
fix outlet emit/face downstream xhi twopass
timestep 2e-08
stats 100
stats_style step cpu np nattempt ncoll nscoll
compute fields grid all gas n nrho massrho u v w trot erot tvib evib usq vsq wsq
compute thermal thermal/grid all gas temp press
fix avg ave/grid all 1 100 100 c_fields[*] c_thermal[*]
compute density grid all species nrho
fix densityavg ave/grid all 1 100 100 c_density[*]
compute mfp lambda/grid f_densityavg[*] f_avg[14] lambda tau knx kny
compute geom property/grid all vol
dump gridout grid all 100 fields.*.grid id xc yc xlo xhi ylo yhi c_geom f_avg[*] f_densityavg[*] c_mfp[*]
run 200
write_restart checkpoint.pilot
print "PILOT_COMPLETE 200"
